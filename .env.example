# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ev_charging_monitoring

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# CORS (comma separated, or * for all)
CORS_ORIGIN=*

# Simulator
SIMULATOR_AUTOSTART=true
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_FAULT_PROBABILITY=0.05

# Logging
LOG_LEVEL=info
